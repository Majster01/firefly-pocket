FIREFLY_URL=

# Firefly rule group titles used by rule suggestions (firefly-pocket-stack's docs/rule-suggestions.md)
#RULE_GROUP_SUGGESTIONS=Suggestions
#RULE_GROUP_CATEGORIZATION=Categorization

APP_NAME="Firefly Pico"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

ASSISTANT_LLM_ENDPOINT=
ASSISTANT_LLM_MODEL=
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_CONTEXT=

ASSISTANT_TRANSCRIPTION_ENDPOINT=
ASSISTANT_TRANSCRIPTION_MODEL=
ASSISTANT_TRANSCRIPTION_API_KEY=
ASSISTANT_TRANSCRIPTION_LANGUAGE=

# Folder with custom icons (.svg/.png/.webp/.jpg) for the icon picker. Defaults to storage/app/custom-icons
#CUSTOM_ICONS_PATH=

# Web Push + app badge (docs/web-push.md). Generate the keys with: npx web-push generate-vapid-keys
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:you@example.com
# Shared secret (32+ characters) with which the FireflyX importer/suggester calls POST /api/internal/notify
#NOTIFY_API_TOKEN=
# Timezone in which a weekly digest's weekday is read (defaults to TZ, then UTC)
#NOTIFY_TIMEZONE=

# Cache of Firefly reads (README: Caching). Use CACHE_DRIVER=redis in production; the store must be shared by all workers
#RESPONSE_CACHE=true
# A config/cache.php store just for this cache; empty = CACHE_DRIVER
#RESPONSE_CACHE_STORE=
# Seconds an answer is kept at most. Changes through Pocket, /api/internal/notify and the Firefly webhook empty it sooner
#RESPONSE_CACHE_TTL=43200
# Firefly's timezone: nothing is kept past its midnight. Empty = TZ, else UTC
#RESPONSE_CACHE_TIMEZONE=Europe/Ljubljana
# Seconds a token Firefly accepted is trusted before asking Firefly again (0 = every request)
#USER_CACHE_TTL=600
# Warm-up after a change (README: Caching): a Firefly personal access token of the same user; empty = off.
# Needs a queue worker (QUEUE_CONNECTION=redis, Horizon); runs WARMUP_DELAY seconds after the first change
#WARMUP_FIREFLY_TOKEN=
#WARMUP_DELAY=60
# Secret of the Firefly webhook that calls POST /api/internal/firefly-webhook (edits made outside Pocket)
#FIREFLY_WEBHOOK_SECRET=
# Server-Timing header on API answers, and SERVER_TIMING_LOG=true for a log line per request
#SERVER_TIMING=true
#SERVER_TIMING_LOG=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# ----- OR ------
#DB_CONNECTION=pgsql
#DB_HOST=
#DB_PORT=5432
#DB_DATABASE=
#DB_USERNAME=
#DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# The docker image overrides this to "redis" and runs the bundled redis + Horizon worker for background jobs
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Local development only: fixed dummy exchange rates instead of calling the rate APIs
#EXCHANGE_RATES_MOCK=false

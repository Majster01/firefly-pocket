# Pocket: the built web app (web/dist) as static files, and the Laravel API
# (server/) under /api. The web app only ever calls /api on its own origin.
#
# add_header is not inherited by a location that sets its own, so every
# location that adds one includes the security headers again.

server {
        listen ${NGINX_PORT};
        server_name _;
        root /var/www/web;
        index index.html;
        charset utf-8;

        gzip on;
        gzip_comp_level 5;
        gzip_min_length 1024;
        gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;

        include /etc/nginx/snippets/security-headers.conf;

        # The API: every request under /api goes to Laravel's front controller.
        # Laravel routes on REQUEST_URI, so the path reaches it as it came.
        location = /api {
            include /etc/nginx/snippets/laravel.conf;
        }
        location ^~ /api/ {
            include /etc/nginx/snippets/laravel.conf;
        }

        # Hashed build output: safe to keep forever. A missing file is a 404,
        # never the app shell.
        location ^~ /assets/ {
            include /etc/nginx/snippets/security-headers.conf;
            add_header Cache-Control "public, max-age=31536000, immutable";
            try_files $uri =404;
        }

        # Asked again on every load, so a new deploy reaches the phone: the
        # app shell, the service worker and the manifest.
        location ~ ^/(index\.html|sw\.js)$ {
            include /etc/nginx/snippets/security-headers.conf;
            add_header Cache-Control "no-cache";
            try_files $uri =404;
        }
        location = /manifest.webmanifest {
            include /etc/nginx/snippets/security-headers.conf;
            add_header Cache-Control "no-cache";
            # Not in every nginx's mime.types
            types { }
            default_type application/manifest+json;
            try_files $uri =404;
        }

        # Everything else: a file from the build, or the app shell (the router
        # is client-side, so /transactions/12 is index.html too).
        location / {
            try_files $uri $uri/ @app;
        }
        location @app {
            include /etc/nginx/snippets/security-headers.conf;
            add_header Cache-Control "no-cache";
            try_files /index.html =404;
        }

        location = /robots.txt { access_log off; log_not_found off; }

        # Hidden files, except .well-known
        location ~ /\.(?!well-known).* {
            deny all;
        }
}
